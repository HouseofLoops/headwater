# Headwater API Environment Configuration
# Copy this file to .env and update the values:  cp .env.example .env
#
# Every variable below is read by app/core/config.py:Settings unless marked
# "(not read by Settings)". Unknown variables are ignored, so it is safe to
# keep infrastructure-only variables (REDIS_PASSWORD, ...) here.
#
# List-valued variables accept either form:
#     API_KEYS=key1,key2
#     API_KEYS=["key1","key2"]
#
# Do NOT use ${VAR} interpolation in this file. The app (python-dotenv) expands
# it, but `docker compose --env-file` passes it through literally, so the two
# disagree. Write the full value out.

# The placeholder credentials below work in development ONLY. Settings
# refuses to start when ENVIRONMENT is anything other than
# development/dev/local/test/testing while API_KEYS, API_KEY or SECRET_KEY
# still holds a value published in this file -- so copying it unchanged can
# never expose a real deployment behind a credential from a public repo.
# Generate real values before you set ENVIRONMENT=production.

# =============================================================================
# API Authentication
# =============================================================================
# Accepted API keys, sent by clients in the X-API-Key header.
# PLACEHOLDER -- replace before any non-development deployment.
API_KEYS=your-secure-api-key-here
# Single-key alias, kept for backward compatibility. If set, it is merged into
# the accepted set alongside API_KEYS. Prefer API_KEYS.
API_KEY=
# Set to false to disable API key auth entirely (all routes become public).
ENABLE_API_KEY_AUTH=true

# =============================================================================
# Application
# =============================================================================
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME=Headwater
DESCRIPTION=API for Google Search, News, Trends and Maps data, plus YouTube transcripts
# VERSION is taken from app/__version__.py; only set this to override it.
# VERSION=

# =============================================================================
# Redis Configuration
# =============================================================================
# REDIS_PASSWORD is consumed by docker-compose (not read by Settings).
REDIS_PASSWORD=your-secure-redis-password-here
# REDIS_URL is intentionally left unset here so this file works as-is for a
# local `uvicorn main:app` run. Redis is optional: without it the rate limiter
# uses its in-process store (single worker only) and caching falls back to
# memory. docker-compose.yml sets REDIS_URL itself, pointing at its own `redis`
# service -- that hostname resolves only inside the compose network, so putting
# it here made every request 503 for anyone following the README without Docker.
#
# Set this for a real deployment. Multi-worker deployments REQUIRE it: the
# in-memory limiter is per-process, so N workers multiply every limit by N, and
# the app refuses to start in production rather than under-enforce silently.
# REDIS_URL=redis://:your-secure-redis-password-here@localhost:6379

# =============================================================================
# Caching Configuration
# =============================================================================
ENABLE_CACHE=true
CACHE_TTL=3600

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_TIMEFRAME=3600

# =============================================================================
# Proxy Configuration
# =============================================================================
ENABLE_PROXY=false
# PROXY_URLS is the one app/core/proxy.py actually reads: comma-separated.
# KNOWN LIMITATION: app/core/proxy.py reads ENABLE_PROXY and PROXY_URLS with
# os.getenv at import time, and pydantic-settings does not export .env values
# into os.environ. Setting these here therefore works under Docker (which
# injects them as real environment variables) but is ignored by a bare
# `uvicorn main:app`. Export them in your shell for local proxy testing.
PROXY_URLS=
# PROXY_URL is a single-proxy setting exposed on Settings for compatibility.
PROXY_URL=

# =============================================================================
# Security / CORS
# =============================================================================
SECRET_KEY=your-secure-secret-key-minimum-32-characters-here
CORS_ORIGINS=http://localhost:3000
CORS_METHODS=*
CORS_HEADERS=*

# =============================================================================
# External API Keys (Optional)
# =============================================================================
X_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# DataForSEO API credentials (Optional; not read by Settings)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# =============================================================================
# Input Sanitization Settings
# =============================================================================
INPUT_SANITIZATION_ENABLED=true
MAX_QUERY_LENGTH=200
ALLOWED_CHARACTERS_PATTERN=^[a-zA-Z0-9\s\-\.\,\?\!\(\)\[\]\{\}\'\"]+$
BLOCK_SUSPICIOUS_PATTERNS=true
# Patterns to block XSS and injection attacks.
SUSPICIOUS_PATTERNS=["<script","javascript:","onload=","onerror=","eval(","alert("]

# =============================================================================
# Connection Pool Settings
# =============================================================================
HTTP_CONNECTION_POOL_SIZE=20
HTTP_MAX_KEEPALIVE_CONNECTIONS=10
HTTP_MAX_CONNECTIONS_PER_HOST=5
HTTP_CONNECTION_TIMEOUT=10.0
HTTP_READ_TIMEOUT=30.0

# =============================================================================
# Batch Processing Settings
# =============================================================================
BATCH_PROCESSING_ENABLED=true
BATCH_SIZE=50
BATCH_TIMEOUT=60.0
MAX_CONCURRENT_BATCHES=3

# =============================================================================
# Autocomplete Settings
# =============================================================================
AUTOCOMPLETE_MAX_PARALLEL_REQUESTS=10
AUTOCOMPLETE_REQUEST_TIMEOUT=30
AUTOCOMPLETE_MAX_RETRIES=3
AUTOCOMPLETE_RETRY_DELAY=1.0

# =============================================================================
# Response Metadata Settings
# =============================================================================
RESPONSE_METADATA_ENABLED=true
INCLUDE_REQUEST_TIMING=true
INCLUDE_CONNECTION_INFO=true
INCLUDE_CACHE_INFO=true
INCLUDE_RATE_LIMIT_INFO=true
